layout {

    focus-ring {
        active-color   "#8aadf4"
        inactive-color "#24273a"
        urgent-color   "#ed8796"
    }

    border {
        active-color   "#8aadf4"
        inactive-color "#24273a"
        urgent-color   "#ed8796"
    }


    tab-indicator {
        active-color   "#8aadf4"
        inactive-color "#424f71"
        urgent-color   "#ed8796"
    }

    insert-hint {
        color "#8aadf480"
    }
}

recent-windows {
    highlight {
        active-color "#8aadf4"
        urgent-color "#ed8796"
    }
}
