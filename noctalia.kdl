layout {

    focus-ring {
        active-color   "#7b83d1"
        inactive-color "#1a1b23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#7b83d1"
        inactive-color "#1a1b23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1a1b2370"
    }

    tab-indicator {
        active-color   "#7b83d1"
        inactive-color "#222a78"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#7b83d180"
    }
}

recent-windows {
    highlight {
        active-color "#7b83d1"
        urgent-color "#fd4663"
    }
}
